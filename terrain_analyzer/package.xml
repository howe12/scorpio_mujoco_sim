<?xml version="1.0"?>
<package format="3">
  <name>terrain_analyzer</name>
  <version>0.1.0</version>
  <description>SE(2) Terrain Analyzer for SEB-Naver (ROS2 port, CPU version)</description>
  <maintainer email="dev@seb-naver.org">seb_naver</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>se2_grid_msgs</depend>
  <depend>se2_grid_core</depend>
  <depend>pcl_conversions</depend>
  <depend>eigen</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
