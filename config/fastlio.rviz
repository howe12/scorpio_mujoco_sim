Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane Cell Count: 50
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Frame Timeout: 15
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: LiDAR PointCloud
      Topic:
        Value: /livox/lidar
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 2
      Color Transformer: Intensity
      Decay Time: 0
      Queue Size: 5
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Map Cloud
      Topic:
        Value: /cloud_registered
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 1
      Color Transformer: Intensity
      Decay Time: 0
      Queue Size: 1
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Trajectory
      Topic:
        Value: /path
        Reliability Policy: Reliable
      Color: 0; 255; 0
      Line Width: 0.03
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Odometry
      Topic:
        Value: /odom
        Reliability Policy: Reliable
      Shape: Arrow
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: 2D Scan
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 255; 0
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 25
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.6
      Target Frame: base_link
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
