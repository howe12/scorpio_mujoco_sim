<mujoco model="scorpio_plaza">
  <!--
    室外广场基础场景 — Scorpio 阿克曼转向机器人
    
    布局 (俯视图, X前 Y左):
        ┌─────────────────────────────┐
        │  🟫木箱         🔴柱子      │
        │       ⬛矮墙       🟩锥桶   │
        │      🤖 →                   │
        │                  🟫木箱     │
        │  🟩锥桶                     │
        │        🔴柱子    ⬛矮墙     │
        │                    🎯目标   │
        └─────────────────────────────┘
    
    机器人所有部件坐标严格对照原始 URDF (scorpio_description):
      base_link 原点在地面 z=0，前方 +X，左方 +Y，上方 +Z
  -->

  <compiler angle="radian" autolimits="true" meshdir="../models/meshes"/>

  <visual>
    <global offwidth="1280" offheight="960"/>
  </visual>

  <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4">
    <flag contact="enable"/>
  </option>

  <size nconmax="400" njmax="600"/>

  <default>
    <joint damping="0.01" frictionloss="0.001"/>
    <geom contype="1" conaffinity="1" friction="0.9 0.02 0.01"/>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.45 0.55 0.7" rgb2="0.1 0.12 0.2" width="512" height="512"/>
    <texture name="ground_tex" type="2d" builtin="checker" rgb1="0.42 0.42 0.4" rgb2="0.5 0.5 0.48" width="512" height="512"/>
    <material name="ground_mat" texture="ground_tex" texrepeat="20 20"/>

    <material name="white_plastic" rgba="0.95 0.95 0.95 1" specular="0.3" shininess="0.5"/>
    <material name="black_rubber" rgba="0.12 0.12 0.12 1"/>
    <material name="dark_grey" rgba="0.35 0.35 0.38 1"/>
    <material name="aluminum" rgba="0.6 0.6 0.62 1" specular="0.5" shininess="0.7"/>
    <material name="sensor_black" rgba="0.08 0.08 0.08 1"/>

    <material name="wood" rgba="0.6 0.4 0.2 1"/>
    <material name="red_plastic" rgba="0.8 0.15 0.1 1"/>
    <material name="concrete" rgba="0.55 0.55 0.55 1"/>
    <material name="orange_cone" rgba="1.0 0.5 0.0 1"/>

    <mesh name="body_mesh" file="scorpio.obj"/>
    <mesh name="left_wheel_mesh" file="left_wheel.obj"/>
    <mesh name="right_wheel_mesh" file="right_wheel.obj"/>
    <mesh name="d435_mesh" file="d435.obj"/>
    <mesh name="ydlidar_g6_mesh" file="ydlidar_g6.obj"/>
  </asset>

  <worldbody>
    <light name="sun" pos="8 8 15" dir="-0.4 -0.4 -1" diffuse="0.9 0.9 0.85" specular="0.3 0.3 0.3" castshadow="true"/>
    <light name="fill" pos="-6 -6 8" dir="0.4 0.4 -1" diffuse="0.35 0.35 0.4"/>

    <geom name="ground" type="plane" size="20 20 0.1" material="ground_mat" contype="1" conaffinity="7"/>

    <!-- ==================== SCORPIO ROBOT ==================== -->
    <body name="base_footprint" pos="0 0 0">
      <freejoint name="base_freejoint"/>

      <body name="base_link" pos="0 0 0">

        <!-- 车体 (room_base_link): URDF joint origin (0,0,0), mesh 顶点自带 z=[0.0325, 0.3101] -->
        <body name="room_base_link" pos="0 0 0">
          <inertial pos="0 0 0.17" mass="3.5" fullinertia="0.035 0.035 0.05 0 0 0"/>
          <geom name="body_visual" type="mesh" mesh="body_mesh" pos="0 0 0"
                material="white_plastic" contype="0" conaffinity="0"/>
          <geom name="body_collision" type="box" pos="0 0 0.1463" size="0.211 0.095 0.1138"
                rgba="1 1 1 0" contype="1" conaffinity="4"/>
        </body>

        <!-- IMU: URDF origin (0.16, 0.04, 0.175) -->
        <site name="imu_site" pos="0.16 0.04 0.175" euler="0 0 -3.14159"/>

        <!-- 后轮 (驱动): URDF (±) x=-0.1575, y=±0.0928, z=0.0525 -->
        <body name="left_rear_wheel" pos="-0.1575 0.0928 0.0525">
          <joint name="left_rear_wheel_joint" type="hinge" axis="0 1 0" damping="0.01" frictionloss="0.001"/>
          <inertial pos="0 0 0" mass="0.3" fullinertia="0.0005 0.0005 0.0003 0 0 0"/>
          <geom name="lr_wheel_visual" type="mesh" mesh="left_wheel_mesh" pos="0 0 0" material="black_rubber" contype="0" conaffinity="0"/>
          <geom name="lr_wheel_collision" type="cylinder" size="0.0525 0.022" quat="0.707 0.707 0 0" material="black_rubber" friction="1.2 0.01 0.005" contype="1" conaffinity="4"/>
        </body>
        <body name="right_rear_wheel" pos="-0.1575 -0.0928 0.0525">
          <joint name="right_rear_wheel_joint" type="hinge" axis="0 1 0" damping="0.01" frictionloss="0.001"/>
          <inertial pos="0 0 0" mass="0.3" fullinertia="0.0005 0.0005 0.0003 0 0 0"/>
          <geom name="rr_wheel_visual" type="mesh" mesh="right_wheel_mesh" pos="0 0 0" material="black_rubber" contype="0" conaffinity="0"/>
          <geom name="rr_wheel_collision" type="cylinder" size="0.0525 0.022" quat="0.707 0.707 0 0" material="black_rubber" friction="1.2 0.01 0.005" contype="1" conaffinity="4"/>
        </body>

        <!-- 前轮 (转向): 转向体在前轴中心 (0.1575, 0, 0.0525) -->
        <body name="steering_assembly" pos="0.1575 0 0.0525">
          <joint name="steering_joint" type="hinge" axis="0 0 1" damping="0.5" frictionloss="0.02" range="-0.785 0.785"/>
          <inertial pos="0 0 0" mass="0.15" fullinertia="0.0001 0.0001 0.0001 0 0 0"/>
          <body name="left_front_wheel" pos="0 0.0928 0">
            <joint name="left_front_wheel_joint" type="hinge" axis="0 1 0" damping="0.01" frictionloss="0.001"/>
            <inertial pos="0 0 0" mass="0.3" fullinertia="0.0005 0.0005 0.0003 0 0 0"/>
            <geom name="lf_wheel_visual" type="mesh" mesh="left_wheel_mesh" pos="0 0 0" material="black_rubber" contype="0" conaffinity="0"/>
            <geom name="lf_wheel_collision" type="cylinder" size="0.0525 0.022" quat="0.707 0.707 0 0" material="black_rubber" friction="1.2 0.01 0.005" contype="1" conaffinity="4"/>
          </body>
          <body name="right_front_wheel" pos="0 -0.0928 0">
            <joint name="right_front_wheel_joint" type="hinge" axis="0 1 0" damping="0.01" frictionloss="0.001"/>
            <inertial pos="0 0 0" mass="0.3" fullinertia="0.0005 0.0005 0.0003 0 0 0"/>
            <geom name="rf_wheel_visual" type="mesh" mesh="right_wheel_mesh" pos="0 0 0" material="black_rubber" contype="0" conaffinity="0"/>
            <geom name="rf_wheel_collision" type="cylinder" size="0.0525 0.022" quat="0.707 0.707 0 0" material="black_rubber" friction="1.2 0.01 0.005" contype="1" conaffinity="4"/>
          </body>
        </body>

        <!-- YDLidar G6 360° 激光雷达 (0.12~16m, 720点, 12Hz)
             安装: 车体顶部平台 z=0.250, 扫描中心 z=0.2817 -->
        <body name="lidar_link" pos="0 0 0.250">
          <inertial pos="0 0 0.02" mass="0.41" fullinertia="6.8e-5 1.3e-4 7.2e-5 0 0 0"/>
          <geom name="lidar_body" type="mesh" mesh="ydlidar_g6_mesh" material="aluminum" contype="0" conaffinity="0"/>
          <site name="lidar_site" pos="0 0 0.03172" euler="0 0 0"/>
        </body>

        <!-- Intel RealSense D435: URDF mount (0.16,0,0.2295) → camera_link (0.1706,0.0175,0.242)
             相机光心置于前端玻璃处以避开自遮挡 -->
        <body name="d435_camera" pos="0.1706 0.0175 0.242">
          <inertial pos="0 0 0" mass="0.072" fullinertia="3.9e-3 5.0e-4 3.9e-3 0 0 0"/>
          <geom name="d435_visual" type="mesh" mesh="d435_mesh"
                pos="0.0043 -0.0175 0" quat="0.5 0.5 0.5 0.5"
                material="aluminum" contype="0" conaffinity="0"/>
          <geom name="d435_collision" type="box" size="0.012525 0.045 0.0125"
                pos="0 -0.0175 0" rgba="1 1 1 0" contype="1" conaffinity="1"/>
          <camera name="d435_depth" pos="0.005 -0.0175 0" quat="0.5 0.5 0.5 0.5" fovy="64" resolution="640 480"/>
          <camera name="d435_rgb"   pos="0.005 -0.0025 0" quat="0.5 0.5 0.5 0.5" fovy="42" resolution="640 480"/>
          <site name="d435_depth_site"   pos="0.005 -0.0175 0" euler="0 1.5708 0"/>
          <site name="d435_left_ir_site" pos="0.005 -0.0175 0" euler="0 1.5708 0"/>
          <site name="d435_right_ir_site" pos="0.005 -0.0675 0" euler="0 1.5708 0"/>
        </body>

      </body>
    </body>

    <!-- ==================== 障碍物 ==================== -->

    <!-- 木箱 (可推动) -->
    <body name="box_wood_1" pos="5 3 0.25">
      <freejoint/><geom type="box" size="0.4 0.4 0.25" material="wood" mass="2.0"/>
    </body>
    <body name="box_wood_2" pos="8 -4 0.25">
      <freejoint/><geom type="box" size="0.5 0.3 0.25" material="wood" mass="2.5"/>
    </body>
    <body name="box_wood_3" pos="-4 5 0.2">
      <freejoint/><geom type="box" size="0.3 0.3 0.2" material="wood" mass="1.5"/>
    </body>

    <!-- 柱子 (固定) -->
    <body name="pillar_1" pos="6 -2 0.5"><geom type="cylinder" size="0.2 0.5" material="red_plastic"/></body>
    <body name="pillar_2" pos="-3 -5 0.5"><geom type="cylinder" size="0.2 0.5" material="red_plastic"/></body>
    <body name="pillar_3" pos="10 6 0.5"><geom type="cylinder" size="0.25 0.5" material="red_plastic"/></body>

    <!-- 矮墙 (固定) -->
    <body name="wall_low_1" pos="4 0 0.3"><geom type="box" size="0.1 2.0 0.3" material="concrete"/></body>
    <body name="wall_low_2" pos="-5 -2 0.3"><geom type="box" size="1.5 0.1 0.3" material="concrete"/></body>

    <!-- 锥桶 (可撞倒) -->
    <body name="cone_1" pos="3 2 0.15"><freejoint/><geom type="cylinder" size="0.08 0.15" material="orange_cone" mass="0.3"/></body>
    <body name="cone_2" pos="7 5 0.15"><freejoint/><geom type="cylinder" size="0.08 0.15" material="orange_cone" mass="0.3"/></body>
    <body name="cone_3" pos="-2 4 0.15"><freejoint/><geom type="cylinder" size="0.08 0.15" material="orange_cone" mass="0.3"/></body>
    <body name="cone_4" pos="9 -1 0.15"><freejoint/><geom type="cylinder" size="0.08 0.15" material="orange_cone" mass="0.3"/></body>

    <!-- 目标点 -->
    <body name="goal_marker" pos="12 8 0.01">
      <geom type="cylinder" size="0.4 0.02" rgba="0.1 0.8 0.2 0.7" contype="0" conaffinity="0" group="3"/>
      <geom type="cylinder" size="0.05 0.5" rgba="0.1 0.8 0.2 0.5" pos="0 0 0.5" contype="0" conaffinity="0" group="3"/>
      <site name="goal_site" pos="0 0 0"/>
    </body>

    <!-- 起点标记 -->
    <body name="start_marker" pos="0 0 0.01">
      <geom type="cylinder" size="0.3 0.005" rgba="0.2 0.4 0.9 0.6" contype="0" conaffinity="0" group="3"/>
    </body>
  </worldbody>

  <!-- 执行器: 后轮力矩驱动 + 前轮位置转向 -->
  <!-- 后轮速度闭环 (ctrl=rad/s, ±1.5Nm) + 前轮位置转向 -->
  <actuator>
    <velocity name="left_rear_motor" joint="left_rear_wheel_joint"
              kv="1.0" ctrlrange="-30 30" forcerange="-1.5 1.5"/>
    <velocity name="right_rear_motor" joint="right_rear_wheel_joint"
              kv="1.0" ctrlrange="-30 30" forcerange="-1.5 1.5"/>
    <position name="steering_actuator" joint="steering_joint" kp="60" kv="8" ctrlrange="-0.785 0.785"/>
  </actuator>

  <!-- 传感器 -->
  <sensor>
    <accelerometer name="imu_accel" site="imu_site"/>
    <gyro name="imu_gyro" site="imu_site"/>
    <jointpos name="enc_left_rear" joint="left_rear_wheel_joint"/>
    <jointpos name="enc_right_rear" joint="right_rear_wheel_joint"/>
    <jointvel name="vel_left_rear" joint="left_rear_wheel_joint"/>
    <jointvel name="vel_right_rear" joint="right_rear_wheel_joint"/>
    <jointpos name="enc_left_front" joint="left_front_wheel_joint"/>
    <jointpos name="enc_right_front" joint="right_front_wheel_joint"/>
    <jointpos name="steering_angle" joint="steering_joint"/>
    <framepos name="base_pos" objtype="body" objname="base_link"/>
    <framequat name="base_quat" objtype="body" objname="base_link"/>
    <framelinvel name="base_linvel" objtype="body" objname="base_link"/>
    <frameangvel name="base_angvel" objtype="body" objname="base_link"/>
    <framepos name="goal_pos" objtype="site" objname="goal_site"/>
    <!-- D435 深度测距 -->
    <rangefinder name="d435_depth_center" site="d435_depth_site"/>
    <rangefinder name="d435_depth_left" site="d435_left_ir_site"/>
    <rangefinder name="d435_depth_right" site="d435_right_ir_site"/>
  </sensor>
</mujoco>
