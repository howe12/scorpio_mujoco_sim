    <geom name="terrain" type="hfield" hfield="terrain_hf" pos="10.0 10.0 0" rgba='0.35 0.4 0.25 1' contype="1" conaffinity="1" friction="0.8 0.02 0.01"/>
    <body name="goal_marker" pos="17.00 17.00 1.130">
      <geom name="goal_visual" type="cylinder" size="0.3 0.5" rgba="0.1 0.8 0.1 0.6" contype="0" conaffinity="0" group="3"/>
      <site name="goal_site" pos="0 0 0"/>
    </body>
    <body name="start_marker" pos="2.00 2.00 0.281">
